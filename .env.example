# Chép file này thành .env khi chạy trên máy. Không đưa file .env lên git.

# Chuỗi kết nối PostgreSQL (loại pooler của Supabase). Bỏ trống thì dùng PGlite trong thư mục data/.
DATABASE_URL=

# Khóa bí mật để mã hóa mã PIN, ít nhất 32 ký tự. Đổi khóa này thì mọi PIN đã lưu không đọc lại được.
PIN_SECRET=

# Địa chỉ của giao diện được phép gọi API. Nhiều địa chỉ thì cách nhau bằng dấu phẩy.
CORS_ORIGIN=http://localhost:5173

# Mã phải nhập ở bước cài đặt lần đầu (tạo chủ sở hữu). Nên đặt khi triển khai lên mạng, để
# người lạ mở trang trước bạn không tự nhận làm chủ được. Bỏ trống thì không hỏi mã.
SETUP_CODE=

PORT=3000
TZ=Asia/Ho_Chi_Minh
